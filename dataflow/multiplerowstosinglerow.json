{
	"name": "multiplerowstosinglerow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "multirowstosinglerow",
						"type": "DatasetReference"
					},
					"name": "sourcedata123"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "destmultirowstosinglerow",
						"type": "DatasetReference"
					},
					"name": "destination"
				}
			],
			"transformations": [
				{
					"name": "pivot1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          Product as string,",
				"          Sales as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourcedata123",
				"sourcedata123 pivot(groupBy(ID),",
				"     pivotBy(Product),",
				"     {} = sum(Sales),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot1",
				"pivot1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Employee_ID as string,",
				"          First_Name as string,",
				"          Salary as string,",
				"          Location as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> destination"
			]
		}
	}
}